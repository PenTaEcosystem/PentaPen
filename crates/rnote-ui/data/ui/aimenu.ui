<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RnAiMenu" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBoxLayout">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
      </object>
    </property>
    <!-- Chat panel: lives inside the window (popovers get clipped and offset on Windows) -->
    <child>
      <object class="GtkBox" id="panel">
        <property name="visible">false</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="width-request">380</property>
        <property name="height-request">470</property>
        <property name="halign">end</property>
        <style>
          <class name="ai_panel" />
        </style>

          <!-- Header: drag it to move the assistant, x closes the panel -->
          <child>
            <object class="GtkBox" id="header">
              <property name="orientation">vertical</property>
              <property name="spacing">2</property>
              <child>
                <object class="GtkBox">
                  <child>
                    <object class="GtkLabel">
                      <property name="label" translatable="yes">Trợ lý hình học AI</property>
                      <property name="halign">start</property>
                      <property name="hexpand">true</property>
                      <attributes>
                        <attribute name="weight" value="bold" />
                      </attributes>
                    </object>
                  </child>
                  <child>
                    <object class="GtkButton" id="close_button">
                      <property name="icon-name">window-close-symbolic</property>
                      <property name="tooltip-text" translatable="yes">Thu gọn</property>
                      <style>
                        <class name="flat" />
                        <class name="circular" />
                      </style>
                    </object>
                  </child>
                </object>
              </child>
              <child>
                <object class="GtkLabel">
                  <property name="label" translatable="yes">Nhấn vào hình trên bảng để sửa trực tiếp hoặc nhập lệnh dựng hình</property>
                  <property name="halign">start</property>
                  <property name="wrap">true</property>
                  <style>
                    <class name="dim-label" />
                    <class name="caption" />
                  </style>
                </object>
              </child>
            </object>
          </child>

          <!-- API settings: any OpenAI-compatible endpoint -->
          <child>
            <object class="GtkExpander">
              <property name="label">Cấu hình API</property>
              <child>
                <object class="GtkGrid">
                  <property name="row-spacing">6</property>
                  <property name="column-spacing">6</property>
                  <property name="margin-top">6</property>
                  <child>
                    <object class="GtkLabel">
                      <property name="label">Nhà cung cấp</property>
                      <property name="xalign">0</property>
                      <layout><property name="column">0</property><property name="row">0</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkDropDown" id="provider_dropdown">
                      <property name="model">
                        <object class="GtkStringList">
                          <items>
                            <item>Google Gemini</item>
                            <item>OpenAI</item>
                            <item>OpenRouter</item>
                            <item>Tùy chỉnh (tương thích OpenAI)</item>
                          </items>
                        </object>
                      </property>
                      <layout><property name="column">1</property><property name="row">0</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkLabel" id="key_hint_label">
                      <property name="xalign">0</property>
                      <property name="wrap">true</property>
                      <property name="use-markup">true</property>
                      <style>
                        <class name="caption" />
                        <class name="dim-label" />
                      </style>
                      <layout><property name="column">0</property><property name="row">1</property><property name="column-span">2</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkLabel">
                      <property name="label">Base URL</property>
                      <property name="xalign">0</property>
                      <layout><property name="column">0</property><property name="row">2</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkEntry" id="base_url_entry">
                      <property name="hexpand">true</property>
                      <property name="placeholder-text">https://api.openai.com/v1</property>
                      <layout><property name="column">1</property><property name="row">2</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkLabel">
                      <property name="label">Model</property>
                      <property name="xalign">0</property>
                      <layout><property name="column">0</property><property name="row">3</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkBox">
                      <property name="spacing">4</property>
                      <child>
                        <object class="GtkEntry" id="model_entry">
                          <property name="hexpand">true</property>
                          <property name="placeholder-text">gemini-2.5-flash</property>
                        </object>
                      </child>
                      <child>
                        <object class="GtkMenuButton" id="model_menubutton">
                          <property name="icon-name">pan-down-symbolic</property>
                          <property name="tooltip-text">Chọn model (bấm "Thử kết nối" để lấy danh sách model của tài khoản)</property>
                        </object>
                      </child>
                      <layout><property name="column">1</property><property name="row">3</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkLabel">
                      <property name="label">API key</property>
                      <property name="xalign">0</property>
                      <layout><property name="column">0</property><property name="row">4</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkPasswordEntry" id="api_key_entry">
                      <property name="show-peek-icon">true</property>
                      <layout><property name="column">1</property><property name="row">4</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkCheckButton" id="animate_check">
                      <property name="label">Vẽ từng nét (hình hiện dần như đang viết)</property>
                      <property name="active">true</property>
                      <layout><property name="column">0</property><property name="row">5</property><property name="column-span">2</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkBox">
                      <property name="spacing">6</property>
                      <property name="halign">end</property>
                      <child>
                        <object class="GtkButton" id="test_button">
                          <property name="label">Thử kết nối</property>
                          <property name="tooltip-text">Kiểm tra key và lấy danh sách model</property>
                        </object>
                      </child>
                      <child>
                        <object class="GtkButton" id="save_key_button">
                          <property name="label">Lưu</property>
                          <style>
                            <class name="suggested-action" />
                          </style>
                        </object>
                      </child>
                      <layout><property name="column">1</property><property name="row">6</property></layout>
                    </object>
                  </child>
                </object>
              </child>
            </object>
          </child>

          <!-- Selected Shape & Center Status Card (text-only, no icon clutter) -->
          <child>
            <object class="GtkBox">
              <property name="orientation">vertical</property>
              <property name="spacing">4</property>
              <style>
                <class name="card" />
              </style>
              <property name="margin-top">2</property>
              <property name="margin-bottom">2</property>
              <child>
                <object class="GtkBox">
                  <property name="spacing">6</property>
                  <property name="margin-start">8</property>
                  <property name="margin-end">8</property>
                  <property name="margin-top">6</property>
                  <child>
                    <object class="GtkLabel" id="center_status_label">
                      <property name="hexpand">true</property>
                      <property name="xalign">0</property>
                      <property name="wrap">true</property>
                      <property name="label">Chưa chọn hình hoặc tâm (Nhấn vào hình trên bảng để sửa trực tiếp)</property>
                      <property name="use-markup">true</property>
                    </object>
                  </child>
                  <child>
                    <object class="GtkButton" id="clear_center_button">
                      <property name="label">Bỏ chọn</property>
                      <property name="tooltip-text" translatable="yes">Bỏ chọn hình hoặc tâm hiện tại</property>
                      <style>
                        <class name="flat" />
                        <class name="caption" />
                      </style>
                    </object>
                  </child>
                </object>
              </child>
              <child>
                <object class="GtkBox">
                  <property name="spacing">6</property>
                  <property name="margin-start">8</property>
                  <property name="margin-end">8</property>
                  <property name="margin-bottom">6</property>
                  <child>
                    <object class="GtkButton" id="pick_center_button">
                      <property name="hexpand">true</property>
                      <property name="label">Chấm tâm trên bảng</property>
                      <property name="tooltip-text" translatable="yes">Nhấp trực tiếp lên bảng vẽ để chấm điểm tâm</property>
                      <style>
                        <class name="flat" />
                        <class name="caption" />
                      </style>
                    </object>
                  </child>
                  <child>
                    <object class="GtkButton" id="center_current_view_button">
                      <property name="label">Lấy giữa màn hình</property>
                      <property name="tooltip-text" translatable="yes">Lấy điểm giữa khung nhìn hiện tại làm tâm</property>
                      <style>
                        <class name="flat" />
                        <class name="caption" />
                      </style>
                    </object>
                  </child>
                </object>
              </child>
            </object>
          </child>

          <!-- Chat Conversation Scroll -->
          <child>
            <object class="GtkScrolledWindow" id="chat_scroller">
              <property name="vexpand">true</property>
              <property name="min-content-height">220</property>
              <property name="hscrollbar-policy">never</property>
              <style>
                <class name="card" />
              </style>
              <property name="child">
                <object class="GtkBox" id="chat_box">
                  <property name="orientation">vertical</property>
                  <property name="spacing">8</property>
                  <property name="margin-top">8</property>
                  <property name="margin-bottom">8</property>
                  <property name="margin-start">8</property>
                  <property name="margin-end">8</property>
                </object>
              </property>
            </object>
          </child>

          <!-- Prompt (multi-line: Enter sends, Shift+Enter breaks the line), point picker, send -->
          <child>
            <object class="GtkBox">
              <property name="spacing">6</property>
              <child>
                <object class="GtkScrolledWindow">
                  <property name="hexpand">true</property>
                  <property name="hscrollbar-policy">never</property>
                  <property name="propagate-natural-height">true</property>
                  <property name="min-content-height">40</property>
                  <property name="max-content-height">140</property>
                  <style>
                    <class name="card" />
                  </style>
                  <property name="child">
                    <object class="GtkTextView" id="prompt_view">
                      <property name="wrap-mode">word-char</property>
                      <property name="accepts-tab">false</property>
                      <property name="top-margin">8</property>
                      <property name="bottom-margin">8</property>
                      <property name="left-margin">8</property>
                      <property name="right-margin">8</property>
                      <property name="tooltip-text" translatable="yes">Enter: gửi · Shift+Enter: xuống dòng</property>
                    </object>
                  </property>
                </object>
              </child>
              <child>
                <object class="GtkBox">
                  <property name="orientation">vertical</property>
                  <property name="spacing">4</property>
                  <property name="valign">end</property>
                  <child>
                    <object class="GtkButton" id="pick_point_button">
                      <property name="icon-name">dot-symbolic</property>
                      <property name="tooltip-text" translatable="yes">Chọn điểm trên bảng: bấm rồi chạm vào một điểm trong 3 giây, tên điểm được chèn vào lệnh</property>
                    </object>
                  </child>
                  <child>
                    <object class="GtkButton" id="send_button">
                      <property name="label">Gửi</property>
                      <property name="tooltip-text" translatable="yes">Gửi lệnh cho AI</property>
                      <style>
                        <class name="suggested-action" />
                      </style>
                    </object>
                  </child>
                </object>
              </child>
            </object>
          </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="bubble">
        <property name="label">AI</property>
        <property name="halign">end</property>
        <property name="width-request">56</property>
        <property name="height-request">56</property>
        <property name="tooltip_text" translatable="yes">Trợ lý hình học AI (phím A) · kéo để di chuyển</property>
        <style>
          <class name="circular" />
          <class name="suggested-action" />
          <class name="ai_bubble" />
        </style>
      </object>
    </child>
  </template>
</interface>
