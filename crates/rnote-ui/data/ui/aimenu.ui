<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RnAiMenu" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBinLayout" />
    </property>
    <child>
      <object class="GtkMenuButton" id="menubutton">
        <property name="label">AI</property>
        <property name="tooltip_text" translatable="yes">Trợ lý hình học AI (phím A)</property>
      </object>
    </child>
    <object class="GtkPopover" id="popover">
      <property name="width-request">400</property>
      <property name="height-request">480</property>
      <child>
        <object class="GtkBox">
          <property name="orientation">vertical</property>
          <property name="spacing">8</property>
          <property name="margin-top">10</property>
          <property name="margin-bottom">10</property>
          <property name="margin-start">10</property>
          <property name="margin-end">10</property>

          <!-- Header (clean text, no icons) -->
          <child>
            <object class="GtkBox">
              <property name="orientation">vertical</property>
              <property name="spacing">2</property>
              <child>
                <object class="GtkLabel">
                  <property name="label" translatable="yes">Trợ lý hình học AI</property>
                  <property name="halign">start</property>
                  <attributes>
                    <attribute name="weight" value="bold" />
                  </attributes>
                </object>
              </child>
              <child>
                <object class="GtkLabel">
                  <property name="label" translatable="yes">Nhấn vào hình trên bảng để sửa trực tiếp hoặc nhập lệnh dựng hình</property>
                  <property name="halign">start</property>
                  <property name="wrap">true</property>
                  <style>
                    <class name="dim-label" />
                    <class name="caption" />
                  </style>
                </object>
              </child>
            </object>
          </child>

          <!-- API settings: any OpenAI-compatible endpoint -->
          <child>
            <object class="GtkExpander">
              <property name="label">Cấu hình API</property>
              <child>
                <object class="GtkGrid">
                  <property name="row-spacing">6</property>
                  <property name="column-spacing">6</property>
                  <property name="margin-top">6</property>
                  <child>
                    <object class="GtkLabel">
                      <property name="label">Base URL</property>
                      <property name="xalign">0</property>
                      <layout><property name="column">0</property><property name="row">0</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkEntry" id="base_url_entry">
                      <property name="hexpand">true</property>
                      <property name="placeholder-text">https://api.openai.com/v1</property>
                      <layout><property name="column">1</property><property name="row">0</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkLabel">
                      <property name="label">Model</property>
                      <property name="xalign">0</property>
                      <layout><property name="column">0</property><property name="row">1</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkEntry" id="model_entry">
                      <property name="placeholder-text">gpt-4o-mini</property>
                      <layout><property name="column">1</property><property name="row">1</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkLabel">
                      <property name="label">API key</property>
                      <property name="xalign">0</property>
                      <layout><property name="column">0</property><property name="row">2</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkPasswordEntry" id="api_key_entry">
                      <property name="show-peek-icon">false</property>
                      <layout><property name="column">1</property><property name="row">2</property></layout>
                    </object>
                  </child>
                  <child>
                    <object class="GtkButton" id="save_key_button">
                      <property name="label">Lưu</property>
                      <property name="halign">end</property>
                      <style>
                        <class name="suggested-action" />
                      </style>
                      <layout><property name="column">1</property><property name="row">3</property></layout>
                    </object>
                  </child>
                </object>
              </child>
            </object>
          </child>

          <!-- Selected Shape & Center Status Card (text-only, no icon clutter) -->
          <child>
            <object class="GtkBox">
              <property name="orientation">vertical</property>
              <property name="spacing">4</property>
              <style>
                <class name="card" />
              </style>
              <property name="margin-top">2</property>
              <property name="margin-bottom">2</property>
              <child>
                <object class="GtkBox">
                  <property name="spacing">6</property>
                  <property name="margin-start">8</property>
                  <property name="margin-end">8</property>
                  <property name="margin-top">6</property>
                  <child>
                    <object class="GtkLabel" id="center_status_label">
                      <property name="hexpand">true</property>
                      <property name="xalign">0</property>
                      <property name="wrap">true</property>
                      <property name="label">Chưa chọn hình hoặc tâm (Nhấn vào hình trên bảng để sửa trực tiếp)</property>
                      <property name="use-markup">true</property>
                    </object>
                  </child>
                  <child>
                    <object class="GtkButton" id="clear_center_button">
                      <property name="label">Bỏ chọn</property>
                      <property name="tooltip-text" translatable="yes">Bỏ chọn hình hoặc tâm hiện tại</property>
                      <style>
                        <class name="flat" />
                        <class name="caption" />
                      </style>
                    </object>
                  </child>
                </object>
              </child>
              <child>
                <object class="GtkBox">
                  <property name="spacing">6</property>
                  <property name="margin-start">8</property>
                  <property name="margin-end">8</property>
                  <property name="margin-bottom">6</property>
                  <child>
                    <object class="GtkButton" id="pick_center_button">
                      <property name="hexpand">true</property>
                      <property name="label">Chấm tâm trên bảng</property>
                      <property name="tooltip-text" translatable="yes">Nhấp trực tiếp lên bảng vẽ để chấm điểm tâm</property>
                      <style>
                        <class name="flat" />
                        <class name="caption" />
                      </style>
                    </object>
                  </child>
                  <child>
                    <object class="GtkButton" id="center_current_view_button">
                      <property name="label">Lấy giữa màn hình</property>
                      <property name="tooltip-text" translatable="yes">Lấy điểm giữa khung nhìn hiện tại làm tâm</property>
                      <style>
                        <class name="flat" />
                        <class name="caption" />
                      </style>
                    </object>
                  </child>
                </object>
              </child>
            </object>
          </child>

          <!-- Chat Conversation Scroll -->
          <child>
            <object class="GtkScrolledWindow" id="chat_scroller">
              <property name="vexpand">true</property>
              <property name="min-content-height">220</property>
              <property name="hscrollbar-policy">never</property>
              <style>
                <class name="card" />
              </style>
              <property name="child">
                <object class="GtkBox" id="chat_box">
                  <property name="orientation">vertical</property>
                  <property name="spacing">8</property>
                  <property name="margin-top">8</property>
                  <property name="margin-bottom">8</property>
                  <property name="margin-start">8</property>
                  <property name="margin-end">8</property>
                </object>
              </property>
            </object>
          </child>

          <!-- Prompt Entry & Send Button -->
          <child>
            <object class="GtkBox">
              <property name="spacing">6</property>
              <child>
                <object class="GtkEntry" id="prompt_entry">
                  <property name="hexpand">true</property>
                  <property name="placeholder-text" translatable="yes">Nhập lệnh vẽ hoặc sửa hình đang chọn (vd: kẻ đường cao AH, đổi nét đứt...)</property>
                </object>
              </child>
              <child>
                <object class="GtkButton" id="send_button">
                  <property name="label">Gửi</property>
                  <property name="tooltip-text" translatable="yes">Gửi lệnh cho AI</property>
                  <style>
                    <class name="suggested-action" />
                  </style>
                </object>
              </child>
            </object>
          </child>
        </object>
      </child>
    </object>
  </template>
</interface>
