<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RnAiMenu" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBinLayout" />
    </property>
    <child>
      <object class="GtkMenuButton" id="menubutton">
        <property name="icon_name">ai-sparkle-symbolic</property>
        <property name="tooltip_text" translatable="yes">AI Geometry Assistant &amp; MCP Tools</property>
      </object>
    </child>
    <object class="GtkPopover" id="popover">
      <property name="width-request">420</property>
      <property name="height-request">540</property>
      <child>
        <object class="GtkBox">
          <property name="orientation">vertical</property>
          <property name="spacing">8</property>
          <property name="margin-top">10</property>
          <property name="margin-bottom">10</property>
          <property name="margin-start">10</property>
          <property name="margin-end">10</property>
          
          <!-- Header -->
          <child>
            <object class="GtkBox">
              <property name="spacing">8</property>
              <property name="valign">center</property>
              <child>
                <object class="GtkImage">
                  <property name="icon-name">ai-sparkle-symbolic</property>
                  <property name="pixel-size">22</property>
                </object>
              </child>
              <child>
                <object class="GtkBox">
                  <property name="orientation">vertical</property>
                  <child>
                    <object class="GtkLabel">
                      <property name="label" translatable="yes">AI Geometry Assistant</property>
                      <property name="halign">start</property>
                      <attributes>
                        <attribute name="weight" value="bold" />
                      </attributes>
                    </object>
                  </child>
                  <child>
                    <object class="GtkLabel">
                      <property name="label" translatable="yes">PentaPen MCP Geometric Solver &amp; Agent</property>
                      <property name="halign">start</property>
                      <style>
                        <class name="dim-label" />
                        <class name="caption" />
                      </style>
                    </object>
                  </child>
                </object>
              </child>
            </object>
          </child>

          <!-- Provider & Model Selection Row -->
          <child>
            <object class="GtkBox">
              <property name="spacing">6</property>
              <child>
                <object class="GtkDropDown" id="provider_dropdown">
                  <property name="tooltip-text" translatable="yes">Chọn nhà cung cấp AI</property>
                  <property name="model">
                    <object class="GtkStringList">
                      <items>
                        <item translatable="false">Ollama (Local AI)</item>
                        <item translatable="false">Google Gemini</item>
                        <item translatable="false">OpenAI</item>
                        <item translatable="false">PentaPen Offline</item>
                      </items>
                    </object>
                  </property>
                </object>
              </child>
              <child>
                <object class="GtkDropDown" id="model_dropdown">
                  <property name="hexpand">true</property>
                  <property name="tooltip-text" translatable="yes">Chọn mô hình AI (Model)</property>
                  <property name="model">
                    <object class="GtkStringList">
                      <items>
                        <item translatable="false">qwen3.5:fast</item>
                        <item translatable="false">qwen3.5:4b</item>
                        <item translatable="false">qwen2.5:1.5b</item>
                      </items>
                    </object>
                  </property>
                </object>
              </child>
              <child>
                <object class="GtkButton" id="refresh_models_button">
                  <property name="label">🔄 Quét</property>
                  <property name="tooltip-text" translatable="yes">Quét lại danh sách mô hình đã tải</property>
                  <style>
                    <class name="flat" />
                  </style>
                </object>
              </child>
            </object>
          </child>

          <!-- Download / Pull Model Row -->
          <child>
            <object class="GtkBox">
              <property name="spacing">6</property>
              <child>
                <object class="GtkEntry" id="pull_model_entry">
                  <property name="hexpand">true</property>
                  <property name="placeholder-text" translatable="yes">Tải model Ollama (vd: qwen2.5:3b, llama3.2)...</property>
                </object>
              </child>
              <child>
                <object class="GtkButton" id="pull_model_button">
                  <property name="label">⬇️ Tải</property>
                  <property name="tooltip-text" translatable="yes">Tải mô hình mới từ thư viện Ollama</property>
                  <style>
                    <class name="suggested-action" />
                  </style>
                </object>
              </child>
            </object>
          </child>

          <!-- API Key Row -->
          <child>
            <object class="GtkBox">
              <property name="spacing">6</property>
              <child>
                <object class="GtkPasswordEntry" id="api_key_entry">
                  <property name="placeholder-text" translatable="yes">API Key (Gemini/OpenAI/MCP)...</property>
                  <property name="show-peek-icon">true</property>
                  <property name="hexpand">true</property>
                </object>
              </child>
              <child>
                <object class="GtkButton" id="save_key_button">
                  <property name="label" translatable="yes">Lưu</property>
                  <property name="tooltip-text" translatable="yes">Lưu API Key</property>
                </object>
              </child>
            </object>
          </child>

          <!-- Quick Action Buttons -->
          <child>
            <object class="GtkBox">
              <property name="spacing">4</property>
              <property name="homogeneous">true</property>
              <child>
                <object class="GtkButton" id="quick_triangle">
                  <property name="label">📐 Tam giác</property>
                  <style>
                    <class name="flat" />
                    <class name="caption" />
                  </style>
                </object>
              </child>
              <child>
                <object class="GtkButton" id="quick_circle">
                  <property name="label">🔴 Đường tròn</property>
                  <style>
                    <class name="flat" />
                    <class name="caption" />
                  </style>
                </object>
              </child>
              <child>
                <object class="GtkButton" id="quick_tangent">
                  <property name="label">📏 Tiếp tuyến</property>
                  <style>
                    <class name="flat" />
                    <class name="caption" />
                  </style>
                </object>
              </child>
              <child>
                <object class="GtkButton" id="quick_centers">
                  <property name="label">🎯 4 Tâm</property>
                  <style>
                    <class name="flat" />
                    <class name="caption" />
                  </style>
                </object>
              </child>
            </object>
          </child>

          <!-- Chat Conversation Scroll -->
          <child>
            <object class="GtkScrolledWindow" id="chat_scroller">
              <property name="vexpand">true</property>
              <property name="min-content-height">200</property>
              <property name="hscrollbar-policy">never</property>
              <style>
                <class name="card" />
              </style>
              <property name="child">
                <object class="GtkBox" id="chat_box">
                  <property name="orientation">vertical</property>
                  <property name="spacing">8</property>
                  <property name="margin-top">8</property>
                  <property name="margin-bottom">8</property>
                  <property name="margin-start">8</property>
                  <property name="margin-end">8</property>
                </object>
              </property>
            </object>
          </child>

          <!-- Prompt Entry & Send Button -->
          <child>
            <object class="GtkBox">
              <property name="spacing">6</property>
              <child>
                <object class="GtkEntry" id="prompt_entry">
                  <property name="hexpand">true</property>
                  <property name="placeholder-text" translatable="yes">Nhập: 'tạo điểm A(100, 200)', 'vẽ tam giác ABC', 'đường cao AH'...</property>
                </object>
              </child>
              <child>
                <object class="GtkButton" id="send_button">
                  <property name="icon-name">dir-right-symbolic</property>
                  <property name="tooltip-text" translatable="yes">Gửi lệnh vẽ cho AI</property>
                  <style>
                    <class name="suggested-action" />
                  </style>
                </object>
              </child>
            </object>
          </child>
        </object>
      </child>
    </object>
  </template>
</interface>
